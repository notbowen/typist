/*
 * Sweep-style 34-key split, XIAO nRF52840, 4x5 diode matrix per half.
 *
 * PCB nets (ergogen/config.yaml):  C0..C4 = pinky..inner column  -> D0..D4
 *                                  R0..R3 = top/home/bottom/thumb -> D5, D8, D9, D10
 * Status LEDs (active high, GPIO -> 1k -> LED -> GND), same pins on both halves:
 *   LED1 = D6, LED2 = D7, LED3 = P0.09 (NFC1 pad), LED4 = P0.10 (NFC2 pad)
 *   -> UART0 is disabled and the NFC pads are switched to GPIO (&uicr below)
 *   thumbs: tucky (inner) on C3, reachy (outer) on C4.
 * Diodes: switch between column and anode, cathode on the row -> col2row.
 * The right half uses the same pins; its hardware columns are also numbered
 * pinky->inner, so the transform lists them mirrored with col-offset 5.
 */
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)    RC(0,9) RC(0,8) RC(0,7) RC(0,6) RC(0,5)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)    RC(1,9) RC(1,8) RC(1,7) RC(1,6) RC(1,5)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)    RC(2,9) RC(2,8) RC(2,7) RC(2,6) RC(2,5)
                        RC(3,3) RC(3,4)    RC(3,9) RC(3,8)
        >;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;
        col-gpios
            = <&xiao_d 0 GPIO_ACTIVE_HIGH>
            , <&xiao_d 1 GPIO_ACTIVE_HIGH>
            , <&xiao_d 2 GPIO_ACTIVE_HIGH>
            , <&xiao_d 3 GPIO_ACTIVE_HIGH>
            , <&xiao_d 4 GPIO_ACTIVE_HIGH>
            ;
        row-gpios
            = <&xiao_d 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };
};

/ {
    status_leds: status_leds {
        compatible = "gpio-leds";
        status_led_1: status_led_1 { gpios = <&xiao_d 6 GPIO_ACTIVE_HIGH>; label = "LED1"; };
        status_led_2: status_led_2 { gpios = <&xiao_d 7 GPIO_ACTIVE_HIGH>; label = "LED2"; };
        status_led_3: status_led_3 { gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>; label = "LED3"; };
        status_led_4: status_led_4 { gpios = <&gpio0 10 GPIO_ACTIVE_HIGH>; label = "LED4"; };
    };
};

/* D6/D7 drive LEDs instead of the UART (the ZMK xiao_ble board already disables
 * xiao_serial = uart0; repeated here so the shield does not depend on that). */
&uart0 {
    status = "disabled";
};

/* P0.09 / P0.10 are the NFC antenna pads by default. This makes Zephyr program
 * UICR.NFCPINS on first boot so they work as plain GPIO (LED3 / LED4).
 * Replaces the deprecated CONFIG_NFCT_PINS_AS_GPIOS. */
&uicr {
    nfct-pins-as-gpios;
};

