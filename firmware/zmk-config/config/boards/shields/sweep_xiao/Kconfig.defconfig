if SHIELD_SWEEP_XIAO_LEFT

config ZMK_KEYBOARD_NAME
    default "Sweep XIAO"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

# central only: read the right half's battery and report it to the host
config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_FETCHING
    default y

config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_PROXY
    default y

endif

if SHIELD_SWEEP_XIAO_LEFT || SHIELD_SWEEP_XIAO_RIGHT

config ZMK_SPLIT
    default y

endif
