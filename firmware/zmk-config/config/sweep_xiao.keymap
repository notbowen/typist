/* Starter keymap: QWERTY + nav/num + symbols + Bluetooth.
 * SYS layer (hold both thumb layer keys): bottom-left Z/X positions show the
 * battery level / connection state on the status LEDs of both halves. */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <behaviors/status_ind.dtsi>   /* &status_ind IND_BAT / IND_CON (status LEDs) */

#define BASE 0
#define NAV  1
#define SYM  2
#define SYS  3

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer { if-layers = <NAV SYM>; then-layer = <SYS>; };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp Q         &kp W         &kp E         &kp R         &kp T        &kp Y  &kp U         &kp I         &kp O         &kp P
&mt LGUI A    &mt LALT S    &mt LCTRL D   &mt LSHFT F   &kp G        &kp H  &mt RSHFT J   &mt RCTRL K   &mt RALT L    &mt RGUI SEMI
&kp Z         &kp X         &kp C         &kp V         &kp B        &kp N  &kp M         &kp COMMA     &kp DOT       &kp FSLH
                                          &lt NAV SPACE &kp TAB      &kp BSPC &lt SYM RET
            >;
        };

        nav {
            bindings = <
&kp N1   &kp N2   &kp N3   &kp N4   &kp N5       &kp N6    &kp N7    &kp N8    &kp N9    &kp N0
&kp ESC  &kp HOME &kp PG_DN &kp PG_UP &kp END    &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &kp SQT
&trans   &trans   &trans   &trans   &trans       &kp DEL   &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT
                           &trans   &trans       &trans    &trans
            >;
        };

        sym {
            bindings = <
&kp EXCL &kp AT   &kp HASH &kp DLLR &kp PRCNT    &kp CARET &kp AMPS  &kp STAR  &kp LPAR  &kp RPAR
&kp GRAVE &kp TILDE &kp PIPE &kp BSLH &kp DQT    &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC  &kp COLON
&trans   &trans   &trans   &trans   &trans       &trans    &trans    &trans    &trans    &trans
                           &trans   &trans       &trans    &trans
            >;
        };

        sys {
            bindings = <
&bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_CLR   &kp F6 &kp F7 &kp F8 &kp F9 &kp F10
&kp F1   &kp F2   &kp F3   &kp F4   &kp F5       &kp F11 &kp F12 &trans &trans &out OUT_TOG
&status_ind IND_BAT &status_ind IND_CON &trans &trans &bootloader  &bootloader &trans &trans &trans &sys_reset
                           &trans   &trans       &trans    &trans
            >;
        };
    };
};
